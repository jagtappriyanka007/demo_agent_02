# Azure OpenAI
AZURE_OPENAI_API_KEY=your-api-key-here
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT=gpt-4o
AZURE_OPENAI_API_VERSION=2024-02-15-preview

# AWS S3 (only if a pulled skill uses blob storage)
AWS_BUCKET_NAME=your-bucket-name
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-key
AWS_REGION_NAME=us-east-1

# Redis (only if a pulled skill uses conversation memory)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Unstructured API (optional — improves PDF parsing in rag-style skills)
UNSTRUCTURED_API_KEY=your-key-here

# Sentry (optional — error monitoring)
SENTRY_DSN=
DISABLE_SENTRY=1
